#encoding utf-8
#
# GY-906
#
DEF GY-906 U 0 40 Y Y 1 F N
F0 "U" 0 0 50 H I C CNN
F1 "GY-906" 0 0 50 H V C CNN
F2 "" 0 0 50 H I C CNN
F3 "" 0 0 50 H I C CNN
DRAW
C -100 -150 50 0 1 0 N
C 0 -350 71 0 1 0 N
C 0 -350 158 0 1 0 N
C 100 -150 50 0 1 0 N
S -200 -700 200 -50 0 1 0 N
X GND ~ -50 -800 100 U 50 50 1 1 W
X SCL ~ 50 -800 100 U 50 50 1 1 U
X SDA ~ 150 -800 100 U 50 50 1 1 B
X VIN ~ -150 -800 100 U 50 50 1 1 W
ENDDRAW
ENDDEF
